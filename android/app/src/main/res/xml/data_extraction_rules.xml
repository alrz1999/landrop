<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of LanDrop goes into cloud backup or device transfer.
     The TLS identity (identity/key.pem) must stay on this device; a restored
     copy would let a second device use the same fingerprint (SECURITY.md S9). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
