  "diagProbeTimeoutDetail": "Nothing came back. A firewall, \"AP / client isolation\" on the router, or being on a different network can cause this.",
  "@diagProbeTimeoutDetail": {
    "description": "Diagnosis finding \"probe-timeout\": what it means."
  },
  "diagProbeTimeoutFix": "Check both devices are on the same Wi-Fi (not a guest network). Allow LanDrop in the firewall. If it still fails, turn on a hotspot on one device and join it from the other.",
  "@diagProbeTimeoutFix": {
    "description": "Diagnosis finding \"probe-timeout\": what to do."
  },
