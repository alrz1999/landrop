    "description": "Diagnosis finding \"probe-refused\": headline."
  },
  "diagProbeRefusedDetail": "The other device answered, but nothing accepted the connection. LanDrop is probably closed there, or it uses a different port.",
  "@diagProbeRefusedDetail": {
    "description": "Diagnosis finding \"probe-refused\": what it means."
  },
  "diagProbeRefusedFix": "Open LanDrop on the other device and keep it in front. Check the address and port shown on its screen.",
  "@diagProbeRefusedFix": {
    "description": "Diagnosis finding \"probe-refused\": what to do."
